{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/flask",
      "runtimeArgs": ["--app", "backend/app", "run", "--port", "5050", "--host", "127.0.0.1"],
      "port": 5050
    },
    {
      "name": "worker",
      "runtimeExecutable": "backend/.venv/bin/flask",
      "runtimeArgs": ["--app", "backend/app", "worker"],
      "port": 5059
    }
  ]
}
