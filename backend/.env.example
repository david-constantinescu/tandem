# ---- Core -------------------------------------------------------------------------------
APP_ENV=development                 # production enforces secure cookies and required secrets
SECRET_KEY=                         # >= 32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=                     # Fernet key(s), comma-separated for rotation:
                                    #   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATABASE_URL=postgresql+psycopg://tandem@127.0.0.1:5433/tandem
REDIS_URL=                          # optional; used for rate-limit storage when set
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5050
SESSION_COOKIE_SECURE=false         # true behind HTTPS (forced in production)
SESSION_TTL_HOURS=336

# ---- Storage (private; objects are encrypted with ENCRYPTION_KEY) ----------------------
STORAGE_TYPE=local                  # local | s3
STORAGE_LOCAL_PATH=                 # default backend/var/storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=                   # S3-compatible endpoint (MinIO, R2...), blank for AWS
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
MAX_UPLOAD_BYTES=20971520
MAX_FILES_PER_UPLOAD=10

# ---- Background jobs (PostgreSQL-backed queue; run `flask worker`) ----------------------
JOB_RUNNER=worker                   # worker | inline (tests / single-process demos)
WORKER_POLL_SECONDS=1.0
SCHEDULED_CHECK_MINUTES=10

# ---- AI providers (see docs/AI_PROVIDER_CONFIGURATION.md) -------------------------------
AI_DEFAULT_PROVIDER=gemini
AI_ALLOW_PAID_MODELS=false          # never silently use paid models
AI_ENABLE_FALLBACK=true
AI_REQUEST_TIMEOUT=90
AI_MAX_RETRIES=2
AI_CACHE_TTL_HOURS=168

GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash      # verified free tier, PDF/image input, structured output (2026-10-30)
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_TEXT_MODEL=glm-4.7-flash                  # free (pricing page); exact id confirmed by `flask check-providers`
ZAI_FAST_MODEL=glm-4.5-flash
ZAI_REASONING_MODEL=glm-4.7-flash
ZAI_VISION_MODEL=glm-4.6v-flash               # free vision model
ZAI_DOCUMENT_MODEL=glm-5.3-flash              # PAID; only used when AI_ALLOW_PAID_MODELS=true
ZAI_IMAGE_DATA_URL=true

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=openai/gpt-oss-20b            # text-only tasks; never receives files
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# ---- Gmail (read-only OAuth) ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/v1/integrations/gmail/callback

# ---- Travel providers (partner access required; see docs/PROVIDER_INTEGRATIONS.md) -----
BOOKING_COM_AFFILIATE_ID=
BOOKING_COM_API_TOKEN=
BOOKING_COM_ENV=sandbox                       # sandbox | production
BOOKING_COM_API_VERSION=3.3
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
EXPEDIA_ENV=test
EXPEDIA_ACTIVITIES_ENABLED=false              # set only after Rapid Activities beta access is granted
VIATOR_API_KEY=
VIATOR_ENV=sandbox
GETYOURGUIDE_ACCESS_TOKEN=
OSM_PLACES_ENABLED=true                       # keyless OpenStreetMap place search (search only)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- Maps / location --------------------------------------------------------------------
LOCATION_PROVIDER=nominatim                   # nominatim | offline
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_CONTACT_EMAIL=                            # required by OSM usage policy for identifying User-Agent
ROUTING_OSRM_URL=                             # optional routing server for travel times (none = "unknown")
MIN_TRANSFER_BUFFER_MINUTES=30
AIRPORT_EXIT_BUFFER_MINUTES=60

# ---- Demo -------------------------------------------------------------------------------
DEMO_MODE=false                     # true: demo-only deployment (registration disabled)
DEMO_ACCOUNT_ENABLED=true           # "Explore the demo" button (isolated per-visitor workspaces)
DEMO_ACCOUNT_EMAIL=demo@tandem.travel
DEMO_ACCOUNT_PASSWORD=              # for `flask seed-demo`; generated and printed once if blank
DEMO_ALLOW_EXTERNAL_AI=true         # demo data is fictional; uses configured AI providers if any
DEMO_SESSION_HOURS=24
DEMO_DAILY_AI_REQUESTS=60

# ---- Rate limiting ----------------------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://     # redis://... in production with several web workers
DEMO_RATE_LIMIT=120 per hour        # demo workspace creations per client IP
TRUSTED_PROXIES=0                   # set to 1 behind one reverse proxy so client IPs come from X-Forwarded-For

# ---- Browser agent (docs/BROWSER_AGENT.md) ----------------------------------------------
BROWSER_WORKER_ENABLED=false        # true where a worker with Playwright + Chromium runs (never on Vercel)
BROWSER_ASSIST_SITES=               # comma-separated real site keys allowed for assisted search, AFTER reviewing
                                    # each site's terms (e.g. trainline,flixbus). Ryanair is always link-only.
BROWSER_CDP_URL=                    # optional remote Chromium (CDP) instead of a local headless browser
CRON_SECRET=                        # protects /api/v1/internal/cron (Vercel Cron sends it automatically)

# Live trip context. Weather (Open-Meteo) and news (Google News RSS, GDELT) need no key.
WEATHER_ENABLED=true
NEWS_ENABLED=true
TAVILY_API_KEY=                      # optional: general web search for the assistant, 1,000 free searches/month
